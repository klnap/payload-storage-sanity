{
  "name": "@klnap/payload-storage-sanity",
  "version": "0.3.0",
  "description": "Sanity-powered storage for Payload CMS with an enhanced media admin UI.",
  "license": "MIT",
  "author": "klnap",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klnap/payload-storage-sanity.git"
  },
  "homepage": "https://github.com/klnap/payload-storage-sanity#readme",
  "bugs": {
    "url": "https://github.com/klnap/payload-storage-sanity/issues"
  },
  "packageManager": "bun@1.4.5",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "./dist/**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin/public.d.ts",
      "import": "./dist/admin/public.js"
    },
    "./client": {
      "types": "./dist/sanity/client/public.d.ts",
      "import": "./dist/sanity/client/public.js"
    },
    "./folders": {
      "types": "./dist/sanity/folders/public.d.ts",
      "import": "./dist/sanity/folders/public.js"
    },
    "./consumers": {
      "types": "./dist/consumers/index.d.ts",
      "import": "./dist/consumers/index.js"
    },
    "./consumers/next": {
      "types": "./dist/consumers/next/index.d.ts",
      "import": "./dist/consumers/next/index.js"
    },
    "./consumers/next/loader": {
      "types": "./dist/consumers/next/loader.d.ts",
      "import": "./dist/consumers/next/loader.js"
    },
    "./styles/admin-tailwind.css": "./dist/admin/tailwind/admin-tailwind.css"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "sanity",
    "storage",
    "media",
    "image-optimization",
    "cdn",
    "nextjs",
    "localization"
  ],
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "build": "bun run build:dist && bun run check:public-api",
    "build:dist": "bun scripts/build-dist.mjs",
    "check": "bun run format && bun run lint && bun run typecheck && bun run knip && bun run check:boundaries && bun run test && bun run test:int && bun run build && bun run verify:package",
    "check:dist-alias": "bun scripts/check-dist-alias.mjs",
    "check:dist-imports": "bun scripts/check-dist-relative-imports.mjs",
    "check:dist": "bun run build:dist && bun run check:dist-alias && bun run check:dist-imports",
    "check:exports": "bun scripts/check-exports.mjs",
    "check:release": "bun run check && bun run check:release-matrix -- --use-dist",
    "check:public-api": "bun scripts/check-public-api.mjs",
    "check:consumer-tree-shaking": "bun scripts/check-consumer-tree-shaking.mjs",
    "check:release-matrix": "bun scripts/run-release-matrix.mjs",
    "test:runtime": "bun scripts/run-release-matrix.mjs --fixture payload-main",
    "check:pack": "bun scripts/check-pack.mjs",
    "check:css-side-effects": "PSS_CSS_WEBPACK=1 bun scripts/verify-css-side-effects.mjs",
    "check:publint": "publint --strict",
    "verify:package": "bun run check:dist-alias && bun run check:dist-imports && bun run check:public-api && bun run check:public-types --use-dist && bun run check:consumer-tree-shaking && bun run check:deps && bun run check:publint && bun run check:attw --use-dist && bun run check:css-side-effects",
    "verify:release-artifact": "bun scripts/verify-release-artifact.mjs",
    "check:boundaries": "depcruise --config dependency-cruiser.config.mjs --output-type err-long src",
    "knip": "knip",
    "check:attw": "bun scripts/check-attw.mjs",
    "check:deps": "bun scripts/check-deps.mjs",
    "check:public-types": "bun scripts/check-public-types.mjs",
    "public-types:snapshot": "bun run build:dist && bun scripts/snapshot-public-types.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:version-check": "bun run changeset:version && bun run check",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "bun test src tests",
    "test:int": "bun scripts/with-ephemeral-postgres.mjs ./scripts/ephemeral-postgres.config.mjs -- bun test tests/integration --max-concurrency 1 --timeout 30000",
    "lint": "biome lint .",
    "format": "biome format .",
    "format:write": "biome format --write ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@payloadcms/plugin-cloud-storage": ">=3.94.1 <4",
    "@sanity/image-url": "^2.1.1",
    "slugify": "^1.6.9",
    "tailwind-variants": "^4.0.2",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "@payloadcms/translations": ">=3.94.1 <4",
    "@payloadcms/ui": ">=3.94.1 <4",
    "@sanity/client": ">=6 <9",
    "next": ">=16.4.5 <17",
    "payload": ">=3.94.1 <4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "3.0.3",
    "@payloadcms/db-postgres": "3.94.1",
    "@payloadcms/plugin-cloud-storage": "3.94.1",
    "@payloadcms/richtext-lexical": "3.94.1",
    "@payloadcms/translations": "3.94.1",
    "@payloadcms/ui": "3.94.1",
    "@sanity/client": "8.17.0",
    "@swc/core": "1.16.22",
    "@tailwindcss/cli": "4.3.5",
    "@types/bun": "1.4.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "css-loader": "7.1.5",
    "dependency-cruiser": "18.8.0",
    "happy-dom": "21.0.4",
    "knip": "6.48.0",
    "npm": "12.2.3",
    "payload": "3.94.1",
    "pg": "8.23.1",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "tsc-alias": "^1.9.10",
    "typescript": "7.0.2",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1"
  },
  "overrides": {
    "esbuild@<=0.24.2": "0.25.12",
    "happy-dom": "21.0.4"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
