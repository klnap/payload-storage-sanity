{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"],
      "@/consumers/next": ["./src/presentation/adapters/next/index.ts"],
      "@/consumers/next/*": ["./src/presentation/adapters/next/*"]
    },
    "types": ["bun"]
  },
  "include": ["src/**/*", "tests/**/*"]
}
