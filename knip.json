{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.ts",
    "src/consumers/index.ts",
    "src/consumers/next/index.ts",
    "src/consumers/next/loader.ts",
    "src/admin/index.ts",
    "src/admin/public.ts",
    "src/sanity/client/index.ts",
    "src/sanity/client/public.ts",
    "src/sanity/folders/index.ts",
    "src/sanity/folders/public.ts",
    "src/core/config/index.ts",
    "tests/**/*.test.ts",
    "tests/**/*.int.test.ts",
    "tests/types/*.ts",
    "tests/unit/consumers/next/*.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.cjs",
    "scripts/**/*.js",
    "src/admin/tailwind/*.css"
  ],
  "project": ["src/**/*.{ts,tsx,css}", "tests/**/*.{ts,tsx}"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "ignoreDependencies": [
    "@tailwindcss/cli",
    "tsc-alias",
    "webpack-cli",
    "css-loader",
    "@payloadcms/translations",
    "next",
    "@payloadcms/plugin-cloud-storage",
    "@swc/core"
  ],
  "ignoreUnresolved": ["scripts/verify-css-side-effects.mjs", "scripts/check-attw.mjs"]
}
