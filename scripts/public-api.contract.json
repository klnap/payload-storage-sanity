  "./consumers": {
    "default": false,
    "runtime": ["buildSanityImageUrl", "isMediaAsset", "isMediaImageAsset"],
    "types": [
      "BuildSanityImageUrlOptions",
      "MediaAsset",
      "MediaImageAsset",
      "SanityAssetReference",
      "SanityImageAssetMapping",
      "SanityImageAssetPath",
      "SanityImageSource"
    ]
  },
  "./consumers/next": {
    "default": false,
    "runtime": ["SanityImage", "createSanityImage", "createSanityImageLoader", "sanityImageLoader"],
    "types": [
      "CreateSanityImageLoaderOptions",
      "CreateSanityImageOptions",
      "MediaAsset",
      "MediaImageAsset",
      "SanityImageAssetMapping",
      "SanityImageAssetPath",
      "SanityImageProps"
    ]
  },
  "./consumers/next/loader": {
    "default": true,
    "runtime": [],
    "types": []
  }
}
