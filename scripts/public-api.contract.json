{
  ".": {
    "default": false,
    "runtime": ["createPopulate", "fullPopulate", "sanityStorage"],
    "types": [
      "PopulateFn",
      "PopulateOptions",
      "PopulateSelect",
      "SanityStorageCollectionOptions",
      "SanityStorageMode",
      "SanityStorageOptions",
      "SanityStorageUploadMaxSizeInput"
    ]
  },
  "./admin": {
    "default": false,
    "runtime": [
      "GalleryList",
      "MediaAssetUpload",
      "MediaMetadataInspector",
      "MediaReferences",
      "MediaUploadBusyShield",
      "MediaUsageInspector",
      "SanityStorageStyles"
    ],
    "types": []
  },
  "./client": {
    "default": false,
    "runtime": ["createSanityClient", "SANITY_IMAGE_METADATA_EXTRACT"],
    "types": ["SanityClientConfig"]
  },
  "./folders": {
    "default": false,
    "runtime": ["assignSanityAssetFolder"],
    "types": []
